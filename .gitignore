# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.local
.env.development.local
.env.production.local
*.pem

# ==========================================
# Python & Virtual Environments
# ==========================================
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
testing/

# ==========================================
# Data Pipeline & Raw Files
# ==========================================
# Ignore scraped raw PDFs and temporary output data
data/raw_pdfs/
data/raw_pdfs/*
data/parsed_json/*
data/qdrant_payloads/*

# Keep data directory structure intact in Git
!data/raw_pdfs/.gitkeep
!data/parsed_json/.gitkeep
!data/qdrant_payloads/.gitkeep

# Crawl4AI cache directories
.crawl4ai/

# ==========================================
# Node.js & React (Backend / Frontend)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# React Build Outputs
frontend/dist/
frontend/build/

# Fastify Build Outputs
backend/dist/
backend/build/

# ==========================================
# Operating System & IDE Artifacts
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo